# All values have defaults; uncomment to override.
# region              = "us-east-1"
# aws_profile         = "tmi"
# cluster_name        = "tmi-eks"
# hosted_zone_name    = "tmi.dev"
# hostname            = "webhook.tmi.dev"
# ingress_group       = "tmi-webhooks"
# url_prefix          = "/tf"
# app_image_tag       = "latest"
# llm_profile         = "gpt56cyber"   # default profile from llm-profiles.yaml
# llm_profiles_yaml   = <<-EOT             # replaces the image's llm-profiles.yaml
#   profiles:
#     opus48: {provider: anthropic, model: claude-opus-4-8, auth: api_key, api_key: ANTHROPIC_API_KEY}
# EOT
# tmi_server_url      = "https://api.tmi.dev"
# max_concurrent_jobs = 3

# Secrets go in secrets.auto.tfvars (git-ignored via *.tfvars):
# webhook_secret    = "..."
# tmi_client_id     = "..."
# tmi_client_secret = "..."
# llm_api_keys      = {                 # keyed by the env var names profiles reference
#   OPENAI_CYBER_API_KEY = "..."
#   ANTHROPIC_API_KEY    = "..."
# }
# github_token      = ""
