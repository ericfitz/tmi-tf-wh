# Local Docker Desktop build — Chainguard Wolfi base
# Smaller, hardened alternative to the OKE Dockerfile. Used by docker-compose.yml.
#
# Build: docker compose build
# Run:   docker compose up

# Stage 1: Builder
FROM cgr.dev/chainguard/wolfi-base:latest AS builder

RUN apk add --no-cache \
        python-3.13 \
        py3.13-pip \
        python-3.13-dev \
        git \
        gcc \
        ca-certificates

# Clone TMI Python client
ARG TMI_CLIENT_REPO=https://github.com/ericfitz/tmi-clients.git
ARG TMI_CLIENT_REF=main
# Commit of TMI_CLIENT_REF; a new value invalidates the cached clone below.
ARG TMI_CLIENT_SHA=unknown
RUN echo "tmi-clients ${TMI_CLIENT_SHA}" && git clone --depth 1 --branch ${TMI_CLIENT_REF} ${TMI_CLIENT_REPO} /opt/tmi-clients

# Newest client at or above the minimum TMI API version this build was built against.
COPY deploy/docker/tmi-api-min-version /tmp/tmi-api-min-version
COPY scripts/select_tmi_client.py /tmp/select_tmi_client.py
RUN python3.13 /tmp/select_tmi_client.py --min-version-file /tmp/tmi-api-min-version \
        --clients /opt/tmi-clients/python-client-generated --out /opt/tmi-client

WORKDIR /app

COPY pyproject.toml ./
COPY tmi_tf/ tmi_tf/

RUN python3.13 -m pip install --no-cache-dir --upgrade pip && \
    python3.13 -m pip install --no-cache-dir --prefix=/install .

# Stage 2: Runtime
FROM cgr.dev/chainguard/wolfi-base:latest

LABEL org.opencontainers.image.title="tmi-tf-wh"
LABEL org.opencontainers.image.description="TMI Terraform Webhook Analyzer (local)"

RUN apk add --no-cache \
        python-3.13 \
        git \
        ca-certificates && \
    ln -sf /usr/bin/python3.13 /usr/bin/python3 && \
    ln -sf /usr/bin/python3.13 /usr/bin/python

# Non-root user
RUN addgroup -S tmi-tf && \
    adduser -S -G tmi-tf -h /home/tmi-tf tmi-tf

COPY --from=builder /install /usr/
COPY --from=builder /opt/tmi-client /opt/tmi-client
COPY --from=hashicorp/terraform:1.15 /bin/terraform /usr/local/bin/terraform
COPY prompts/ /opt/tmi-tf/prompts/
ENV PROMPTS_DIR=/opt/tmi-tf/prompts
COPY llm-profiles.yaml /opt/tmi-tf/llm-profiles.yaml
ENV LLM_PROFILES_FILE=/opt/tmi-tf/llm-profiles.yaml

ENV HOME=/home/tmi-tf \
    TMI_CLIENT_PATH=/opt/tmi-client \
    PYTHONUNBUFFERED=1

EXPOSE 8088

USER tmi-tf
WORKDIR /home/tmi-tf

ENTRYPOINT ["python3", "-m", "uvicorn", "tmi_tf.server:app", "--host", "0.0.0.0", "--port", "8088"]
