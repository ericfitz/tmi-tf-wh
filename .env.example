# TMI Server Configuration
TMI_SERVER_URL=https://api.tmi.dev
# OAuth identity provider: "google" (browser PKCE flow) or "tmi" (client_credentials)
TMI_OAUTH_IDP=google
# TMI client_credentials (required if TMI_OAUTH_IDP=tmi)
# TMI_CLIENT_ID=your_client_id
# TMI_CLIENT_SECRET=your_client_secret

# LLM profiles (powered by LiteLLM). Profiles are defined in llm-profiles.yaml;
# LLM_PROFILE is the default, overridden per run by --profile or per invocation
# by user_data {"profile": "<name>"}.
LLM_PROFILE=gpt56cyber
# LLM_PROFILES_FILE=/path/to/llm-profiles.yaml

# API keys, named as the profiles' api_key fields reference them
OPENAI_CYBER_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OCI Generative AI (profiles with auth: oci)
# Uses ~/.oci/config for authentication credentials
# OCI_CONFIG_PROFILE=DEFAULT
# OCI_COMPARTMENT_ID=ocid1.compartment.oc1..your_compartment_id

# GitHub API Configuration (optional - for higher rate limits)
GITHUB_TOKEN=your_github_token_here

# Application Settings
MAX_REPOS=3
CLONE_TIMEOUT=300

# Base names for notes and diagrams (model name will be appended automatically)
ANALYSIS_NOTE_NAME=Terraform Analysis Report
DIAGRAM_NAME=Infrastructure Data Flow Diagram

# Server mode configuration (webhook service)
# Queue provider: "oci" (inferred from QUEUE_OCID), "aws" (inferred from QUEUE_URL),
# or "memory" (local dev, in-process)
# QUEUE_PROVIDER=memory
# QUEUE_OCID=ocid1.queue.oc1..example
# QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/tmi-tf-wh-jobs
# AWS_REGION=us-east-1
# VAULT_OCID=ocid1.vault.oc1..example
# WEBHOOK_SECRET=your-hmac-shared-secret
# WEBHOOK_SUBSCRIPTION_ID=optional-subscription-uuid
# MAX_CONCURRENT_JOBS=3
# JOB_TIMEOUT=3600
# Commit window used by the "latest" scope, and the sparse-clone pull depth
# LATEST_COMMIT_DEPTH=200
# MAX_MESSAGE_AGE_HOURS=24
# SERVER_PORT=8080
# Path prefix when several webhook apps share one hostname (e.g. /tf); empty = none.
# Read from the ambient environment at import time (shell, container env), not just .env.
# URL_PREFIX=
# TMI_CLIENT_PATH=/opt/tmi-tf-wh/vendor/tmi-client
